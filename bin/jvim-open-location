#!/usr/bin/env python3
"""Handle only a numeric definition jump to a registered, owned jvim socket."""
import json
import os
from pathlib import Path
import re
import stat
import subprocess
import sys
from urllib.parse import urlsplit

def main():
    if len(sys.argv) != 2:
        return
    uri = urlsplit(sys.argv[1])
    if uri.scheme != 'jvim-definition' or not re.fullmatch('[a-f0-9]{32}', uri.netloc):
        return
    parts = uri.path.strip('/').split('/')
    if len(parts) != 4 or not all(re.fullmatch('[0-9]{1,9}', part) for part in parts):
        return
    win, buf, row, col = map(int, parts)
    if not win or not buf or not row:
        return
    registry = Path.home()/'.local/state/jvim/jvim-links'/(uri.netloc+'.json')
    if not registry.exists() or registry.stat().st_uid != os.getuid():
        return
    data = json.loads(registry.read_text())
    socket = Path(data['socket'])
    info = socket.stat()
    if info.st_uid != os.getuid() or not stat.S_ISSOCK(info.st_mode):
        return
    expr = f'luaeval("require([[custom.definition_links]]).jump(_A[1], _A[2], _A[3], _A[4])", [{win},{buf},{row},{col}])'
    runtime = json.loads((Path.home()/'.local/share/jvim/runtime.json').read_text())
    subprocess.run([runtime['nvim'],'--server',str(socket),'--remote-expr',expr], stdout=subprocess.DEVNULL, timeout=10, check=True)

if __name__ == '__main__':
    try:
        main()
    except (OSError, ValueError, KeyError, subprocess.SubprocessError):
        pass
